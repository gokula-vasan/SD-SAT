        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipientAccountNumber\": \"ACC-1000200032\",\n  \"amount\": \"1500.00\",\n  \"description\": \"Payment for consulting work\",\n  \"idempotencyKey\": \"demo-idemp-001\"\n}"
